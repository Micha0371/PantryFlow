{
  "expo": {
    "name": "Pantry Flow",
    "slug": "pantry-flow",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pantryflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pantryflow.app"
    },
    "android": {
      "package": "com.householdkit.pantryflow",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F1"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "./plugins/with-backup-exclusion.cjs"
    ]
  }
}
