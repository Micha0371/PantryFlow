{
  "name": "pantry-flow",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-node-tests.cjs",
    "test:legacy": "node scripts/run-node-tests.cjs",
    "test:components": "jest --runInBand --randomize --showSeed",
    "test:safety": "tsx --test --test-randomize tests/integration/local-stack.test.ts",
    "test:independence": "node scripts/check-test-independence.cjs",
    "test:isolated": "node scripts/run-tests-alone.cjs",
    "test:fast": "npm run test:independence && npm run typecheck && npm run test:legacy && npm run test:components && npm run test:safety",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,studio,logflare,vector,supavisor",
    "db:reset": "node scripts/run-local-db.cjs reset",
    "test:db": "node scripts/run-local-db.cjs test",
    "test:rls-mutations": "node scripts/check-rls-mutations.cjs",
    "test:integration": "node scripts/run-local-db.cjs integration tests/integration/behavior.integration.ts tests/integration/email-confirmation.integration.ts tests/integration/shopping-data.integration.ts tests/integration/pantry-shopping.integration.ts tests/integration/pantry-status.integration.ts tests/integration/profile-language.integration.ts tests/integration/test-users.integration.ts tests/integration/write-isolation.integration.ts",
    "test:local": "node scripts/run-local-db.cjs local",
    "e2e:prepare": "tsx scripts/e2e-fixtures.ts prepare",
    "e2e:verify": "tsx scripts/e2e-fixtures.ts verify:slice-1-1",
    "e2e:cleanup": "tsx scripts/e2e-fixtures.ts cleanup",
    "e2e:build": "node scripts/build-e2e.cjs",
    "test:e2e": "node scripts/run-e2e.cjs",
    "postinstall": "node scripts/patch-expo-windows.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.0.0",
    "babel-preset-expo": "~58.0.24",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "supabase": "3.2.0",
    "test-renderer": "~1.3.1",
    "tsx": "4.20.6",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": "^24.16.0 || ^26.1.0 || >=27.0.0"
  }
}
